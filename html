<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>團隊用餐登記</title>
  <style>
    /* 基礎樣式設計，模擬你的 UI 風格 */
    body { font-family: "Microsoft JhengHei", sans-serif; background-color: #fdfaf4; color: #4a3728; margin: 20px; }
    .container { display: flex; gap: 20px; max-width: 1000px; margin: 0 auto; background: white; padding: 20px; border-radius: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); }
    .left-panel { flex: 2; }
    .right-panel { flex: 1; background-color: #fffdf9; border: 1px solid #f0e6df; border-radius: 8px; padding: 15px; position: relative; }
    
    /* 頂部與下拉選單 */
    .header-title { font-size: 24px; font-weight: bold; margin-bottom: 15px; color: #d35400; }
    select { padding: 8px; font-size: 16px; border-radius: 6px; border: 1px solid #ccc; width: 100%; max-width: 200px; margin-bottom: 20px; }
    
    /* 日曆樣式 */
    .calendar-header { display: flex; justify-content: center; align-items: center; gap: 20px; font-size: 22px; font-weight: bold; margin-bottom: 15px; }
    .nav-btn { background: none; border: 1px solid #ccc; border-radius: 4px; padding: 5px 10px; cursor: pointer; font-size: 16px; }
    .calendar-grid { display: grid; grid-template-columns: repeat(7, 1fr); text-align: center; gap: 8px; }
    .weekday { font-weight: bold; padding: 10px 0; border-bottom: 2px solid #f0e6df; }
    .day { padding: 12px 0; cursor: pointer; border-radius: 50%; aspect-ratio: 1; display: flex; align-items: center; justify-content: center; font-size: 16px; }
    .day:hover { background-color: #f5f5f5; }
    .day.selected { background-color: #e65100; color: white; font-weight: bold; }
    .day.empty { cursor: default; }
    .day.empty:hover { background: none; }

    /* 右側明細 */
    .detail-title { font-size: 18px; font-weight: bold; border-bottom: 1px dashed #ccc; padding-bottom: 5px; margin-bottom: 10px; }
    .info-text { margin: 8px 0; color: #7f8c8d; }
    .info-text span { color: #d35400; font-weight: bold; }
    .date-list { min-height: 100px; max-height: 150px; overflow-y: auto; border: 1px solid #f0e6df; padding: 5px; border-radius: 4px; font-size: 14px; margin-bottom: 15px; background: #fff; }
    .date-item { padding: 4px 5px; border-bottom: 1px solid #eee; }
    .price-box { font-size: 20px; font-weight: bold; text-align: right; color: #d35400; margin-bottom: 15px; }
    .submit-btn { width: 100%; background-color: #e65100; color: white; border: none; padding: 12px; font-size: 18px; font-weight: bold; border-radius: 6px; cursor: pointer; }
    .submit-btn:hover { background-color: #bf360c; }

    /* 彈出確認視窗 */
    .modal-overlay { display: none; position: fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); justify-content:center; align-items:center; z-index:100; }
    .modal { background: white; padding: 25px; border-radius: 8px; width: 300px; text-align: center; box-shadow: 0 4px 15px rgba(0,0,0,0.2); }
    .modal-btns { display: flex; justify-content: space-between; margin-top: 20px; gap: 10px; }
    .modal-btn { flex: 1; padding: 10px; border-radius: 4px; border: none; cursor: pointer; font-size: 16px; }
    .btn-cancel { background: #eee; color: #333; }
    .btn-confirm { background: #e65100; color: white; }
  </style>
</head>
<body>

<div class="container">
  <!-- 左側日曆與姓名選單 -->
  <div class="left-panel">
    <div class="header-title">團隊用餐登記 🍱</div>
    
    <label for="nameSelect">選擇姓名：</label>
    <select id="nameSelect">
      <option value="陳志明">陳志明</option>
      <option value="林小美">林小美</option>
      <option value="王大同">王大同</option>
    </select>

    <!-- 日曆區域 -->
    <div class="calendar-header">
      <button class="nav-btn" onclick="changeMonth(-1)">◀</button>
      <span id="calendarTitle">2026 年 8 月</span>
      <button class="nav-btn" onclick="changeMonth(1)">▶</button>
    </div>
    
    <div class="calendar-grid" id="calendarGrid">
      <!-- 由 JavaScript 動態生成日曆 -->
    </div>
  </div>

  <!-- 右側明細面版 -->
  <div class="right-panel">
    <div class="detail-title">📝 登記明細</div>
    <div class="info-text">餐點由餐飲公司統一供應，每份餐點 <span>NT$ 100</span></div>
    <div class="info-text">登記人員：<span id="displayName">陳志明</span></div>
    <div class="info-text">已選擇用餐日期：</div>
    
    <!-- 已選日期清單 -->
    <div class="date-list" id="selectedDateList">
      <!-- 動態顯示已選日期 -->
    </div>
    
    <div class="price-box">
      總金額：<span id="totalAmount">NT$ 0</span>
    </div>
    
    <button class="submit-btn" onclick="openModal()">確認登記</button>
  </div>
</div>

<!-- 彈出再次確認視窗 -->
<div class="modal-overlay" id="confirmModal">
  <div class="modal">
    <h3>🔍 請再次確認</h3>
    <p style="text-align: left; line-height: 1.6;">
      登記人員：<span id="modalName"></span><br>
      用餐天數：<span id="modalDays" style="color:#d35400; font-weight:bold;"></span> 天<br>
      總金額　：<span id="modalAmount" style="color:#d35400; font-weight:bold;"></span>
    </p>
    <div class="modal-btns">
      <button class="modal-btn btn-cancel" onclick="closeModal()">返回修改</button>
      <button class="modal-btn btn-confirm" onclick="submitData()">確認送出</button>
    </div>
  </div>
</div>

<script>
  // 🚀 請在此處更換為你部署好的 Google Apps Script 網頁應用程式 URL
  const scriptURL = 'https://script.google.com/macros/s/AKfycbxpFnHN6ndD9gpKgI2-TCyR_DeVHSXA2ml-D587anKod81SJ9RymDv4ae_lauKw8nbH/exec';

  // 目前日曆顯示的年與月
  let currentYear = 2026;
  let currentMonth = 8; // 8 代表 8 月 (1-12)
  const pricePerMeal = 100;

  // 用來儲存所有被勾選日期的資料結構。格式為 "YYYY/M/D" 的字串陣列，例如 ["2026/8/3", "2026/8/5"]
  let selectedDates = [];

  // 初始化網頁
  document.addEventListener("DOMContentLoaded", () => {
    initCalendar();
    
    // 監聽姓名下拉選單變更
    document.getElementById("nameSelect").addEventListener("change", (e) => {
      document.getElementById("displayName").innerText = e.target.value;
    });
  });

  // 生成日曆主功能
  function initCalendar() {
    const grid = document.getElementById("calendarGrid");
    const title = document.getElementById("calendarTitle");
    
    // 更新標題
    title.innerText = `${currentYear} 年 ${currentMonth} 月`;
    
    // 清空舊日曆內容，先塞入星期標題
    grid.innerHTML = `
      <div class="weekday">日</div><div class="weekday">一</div><div class="weekday">二</div>
      <div class="weekday">三</div><div class="weekday">四</div><div class="weekday">五</div><div class="weekday">六</div>
    `;

    // 取得該月的第一天是星期幾，以及該月總共有幾天
    const firstDayIndex = new Date(currentYear, currentMonth - 1, 1).getDay();
    const totalDays = new Date(currentYear, currentMonth, 0).getDate();

    // 填補第一天之前的空白格子
    for (let i = 0; i < firstDayIndex; i++) {
      const emptyDiv = document.createElement("div");
      emptyDiv.className = "day empty";
      grid.appendChild(emptyDiv);
    }

    // 開始畫出每一天的按鈕
    for (let day = 1; day <= totalDays; day++) {
      const dayDiv = document.createElement("div");
      dayDiv.className = "day";
      dayDiv.innerText = day;
      
      const dateStr = `${currentYear}/${currentMonth}/${day}`;
      
      // 如果這個日期之前已經被選過了，要維持選取樣式
      if (selectedDates.includes(dateStr)) {
        dayDiv.classList.add("selected");
      }

      // 點擊日期的事件
      dayDiv.onclick = () => {
        if (selectedDates.includes(dateStr)) {
          // 如果已選，就取消選取
          selectedDates = selectedDates.filter(d => d !== dateStr);
          dayDiv.classList.remove("selected");
        } else {
          // 如果沒選，就加進去
          selectedDates.push(dateStr);
          dayDiv.classList.add("selected");
        }
        updateDetails();
      };

      grid.appendChild(dayDiv);
    }
  }

  // 切換月份按鈕
  function changeMonth(direction) {
    currentMonth += direction;
    if (currentMonth > 12) {
      currentMonth = 1;
      currentYear++;
    } else if (currentMonth < 1) {
      currentMonth = 12;
      currentYear--;
    }
    initCalendar();
  }

  // 更新右側明細面板與金額
  function updateDetails() {
    const listContainer = document.getElementById("selectedDateList");
    const amountSpan = document.getElementById("totalAmount");
    listContainer.innerHTML = "";

    // 將選中的日期排序（先排年份、月份、日期）
    selectedDates.sort((a, b) => new Date(a) - new Date(b));

    // 轉換成易讀的格式顯示，例如 "8/3 (一)"
    selectedDates.forEach(dateStr => {
      const d = new Date(dateStr);
      const m = d.getMonth() + 1;
      const dateNum = d.getDate();
      const dayOfWeek = ["日", "一", "二", "三", "四", "五", "六"][d.getDay()];
      
      const item = document.createElement("div");
      item.className = "date-item";
      item.innerText = `📅 ${m}/${dateNum} (一)`; // 這邊簡化顯示，依實際星期自動帶入
      item.innerText = `📅 ${m}/${dateNum} (${dayOfWeek})`;
      listContainer.appendChild(item);
    });

    // 計算總金額
    const totalCost = selectedDates.length * pricePerMeal;
    amountSpan.innerText = `NT$ ${totalCost}`;
  }

  // 打開確認視窗
  function openModal() {
    if (selectedDates.length === 0) {
      alert("請至少選擇一天用餐日期！");
      return;
    }
    document.getElementById("modalName").innerText = document.getElementById("nameSelect").value;
    document.getElementById("modalDays").innerText = selectedDates.length;
    document.getElementById("modalAmount").innerText = `NT$ ${selectedDates.length * pricePerMeal}`;
    document.getElementById("confirmModal").style.display = "flex";
  }

  // 關閉確認視窗
  function closeModal() {
    document.getElementById("confirmModal").style.display = "none";
  }

  // 🚀 核心功能：打包並上傳資料到 Google 試算表
  function submitData() {
    const name = document.getElementById("nameSelect").value;
    const totalDays = selectedDates.length;
    const totalAmount = totalDays * pricePerMeal;
    
    // 將陣列物件轉成易讀的字串：例如 "8/3(一), 8/5(三)"
    const dateDetailsString = selectedDates.map(dateStr => {
      const d = new Date(dateStr);
      const m = d.getMonth() + 1;
      const dateNum = d.getDate();
      const dayOfWeek = ["日", "一", "二", "三", "四", "五", "六"][d.getDay()];
      return `${m}/${dateNum}(${dayOfWeek})`;
    }).join(", ");

    // 建立要傳給後端 GAS 的 JSON 封包
    const payload = {
      sheetName: `${currentYear}/${currentMonth}`, // 工作表名稱會是 "2026/8"
